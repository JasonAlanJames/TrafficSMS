APP_NAME=TrafficSMS
APP_ENV=development
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://trafficsms:trafficsms@postgres:5432/trafficsms
DATABASE_ASYNC_URL=postgresql+asyncpg://trafficsms:trafficsms@postgres:5432/trafficsms
REDIS_URL=redis://redis:6379/0

SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=120
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_WINDOW_MINUTES=15
FAILED_LOGIN_RATE_LIMIT_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=15
REFRESH_TOKEN_RETENTION_DAYS=30

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
MAIL_FROM=no-reply@trafficsms.local
MAIL_FROM_NAME=TrafficSMS

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+15555550123

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STANDARD_MONTHLY_PRODUCT_ID=prod_standard_replace_me
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_standard_replace_me
STRIPE_UNLIMITED_MONTHLY_PRODUCT_ID=prod_unlimited_replace_me
STRIPE_UNLIMITED_MONTHLY_PRICE_ID=price_unlimited_replace_me
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard
ADMIN_EMAILS=admin@example.com
BILLING_GRACE_PERIOD_DAYS=3

GOOGLE_MAPS_API_KEY=replace_me
GOOGLE_MAPS_TIMEOUT_SECONDS=10

TRAFFIC_CACHE_TTL_SECONDS=90
TRAFFIC_CACHE_STALE_SECONDS=900
TRAFFIC_CACHE_LOCK_SECONDS=15
